# Copie este arquivo para .env e preencha com os dados do seu projeto Supabase
# (Project Settings → API). Use só a chave publishable: nunca a service_role.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua-chave-publishable

# Notificações (opcional): chave pública gerada com `npx web-push generate-vapid-keys`.
# A chave privada NUNCA vem aqui: ela fica nos secrets da função no Supabase.
VITE_VAPID_PUBLIC_KEY=
